{
  "name": "decky-scope",
  "version": "0.1.0-rc.2",
  "description": "Read-only SteamOS diagnostics and performance history",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "test:ui": "node --test tests/*.test.mjs",
    "format": "prettier --write src package.json",
    "build:monitor": "bash scripts/build-monitor.sh",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
